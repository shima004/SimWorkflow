{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "argo": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "externalURL": {
          "type": "string",
          "pattern": "^$|^https?://[^/@?#]+/?$"
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "archive": {
              "type": "boolean"
            },
            "nodeStatusOffLoad": {
              "type": "boolean"
            }
          }
        },
        "controllerConfig": {
          "type": "object"
        }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "externalHost": {
          "type": "string"
        },
        "externalPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "ssl": {
          "type": "boolean"
        }
      }
    },
    "s3": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "externalURL": {
          "type": "string",
          "pattern": "^$|^https?://[^/@?#]+/?$"
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            }
          }
        },
        "persistence": {
          "type": "object",
          "properties": {
            "existingClaim": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "minLength": 1
            },
            "keep": {
              "type": "boolean"
            }
          }
        },
        "bucket": {
          "type": "string",
          "minLength": 3,
          "maxLength": 63,
          "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "forcePathStyle": {
          "type": "boolean"
        },
        "bucketInit": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "registry": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "externalURL": {
          "type": "string",
          "pattern": "^$|^https?://[^/@?#]+/?$"
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            }
          }
        },
        "persistence": {
          "type": "object",
          "properties": {
            "existingClaim": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "minLength": 1
            },
            "keep": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "properties": {
        "serviceAccount": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
            }
          }
        },
        "clientServiceAccount": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
            }
          }
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "rbac": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "cli": {
      "type": "object",
      "properties": {
        "argoURL": {
          "type": "string",
          "pattern": "^$|^https?://[^/@?#]+/?$"
        },
        "simScopeURL": {
          "type": "string"
        },
        "helperImage": {
          "type": "string"
        },
        "httpTimeout": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
