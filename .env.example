# Copy to .env for local connection settings.
# Store secrets with: simworkflow credentials set <argo|s3|registry>
# Authentication is read from the OS keyring or process environment, not .env.
CREDENTIALS_STORE=keyring
# Existing environment variables take precedence, including empty values.

ARGO_WORKFLOW_SERVER=https://argo.example.com
ARGO_WORKFLOW_NAMESPACE=argo

S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=workflows
# true for services such as MinIO that require path-style bucket URLs.
S3_FORCE_PATH_STYLE=true

# Include http:// or https://. Do not include credentials in URLs.
REGISTRY_URL=https://registry.example.com

HTTP_TIMEOUT=30s

# Optional: viewer opened by pressing w in the progress TUI's run details.
SIMSCOPE_URL=
