# Copy to .env for local development. Never commit real credentials.
# Existing environment variables take precedence, including empty values.

ARGO_WORKFLOW_SERVER=https://argo.example.com
ARGO_WORKFLOW_NAMESPACE=argo
# Optional: raw token, without the Bearer prefix. Empty for anonymous access.
ARGO_WORKFLOW_TOKEN=

S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=workflows
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
# Optional temporary credential session token.
S3_SESSION_TOKEN=
# true for services such as MinIO that require path-style bucket URLs.
S3_FORCE_PATH_STYLE=true

# Include http:// or https://. Do not include credentials in URLs.
REGISTRY_URL=https://registry.example.com
# Leave all authentication fields empty for anonymous access.
# Use either username/password OR a raw bearer token.
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
REGISTRY_TOKEN=

HTTP_TIMEOUT=30s
